# ── Supabase (https://supabase.com) ─────────────────────────────
# Project URL (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Public anon key (safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# Service-role key — SERVER ONLY, never expose or prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Dharma Vault (private admin) ────────────────────────────────
# Secret URL segment: the Vault lives at /<ADMIN_SECRET_TOKEN>. Make it long and unguessable.
ADMIN_SECRET_TOKEN=change-me-to-a-long-random-string
# Password asked on the Vault login screen
ADMIN_PASSWORD=your_strong_password_here
# Signs the admin session cookie (min 32 chars). Set this in production!
JWT_SECRET=your_jwt_secret_minimum_32_chars_here

# ── Email notifications (contact form + onboarding submissions) ─
# Where notifications are sent (defaults to dharmawebservice@gmail.com)
MAIL_TO=dharmawebservice@gmail.com,dharmu17reddy@gmail.com
# Option A — Resend (https://resend.com): used first if set
RESEND_API_KEY=
# Sender for Resend, e.g. "DWS Website <hello@yourdomain.com>" (defaults to onboarding@resend.dev)
MAIL_FROM=
# Option B — Brevo (https://brevo.com): used if RESEND_API_KEY is empty
BREVO_API_KEY=
# Verified sender email for Brevo
MAIL_FROM_EMAIL=

# ── Site ────────────────────────────────────────────────────────
# Public site URL, used in links inside emails
NEXT_PUBLIC_SITE_URL=https://www.dharmawebservice.in
